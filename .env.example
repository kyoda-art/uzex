# Telegram bot tokeni (BotFather'dan)
TELEGRAM_BOT_TOKEN=

# Gemini API kaliti (ixtiyoriy). Bo'sh qolsa bot qoidalar rejimida ishlaydi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Birja ma'lumotlari papkasi (deals_*.csv, contracts.csv, ... shu yerda bo'lishi kerak)
UZEX_DATA_DIR=./data/uzex_spot_data

# Statistika: kim botdan foydalangani shu faylga yoziladi (git'ga tushmaydi)
USAGE_FILE=data/usage.json

# /stats buyrug'ida foydalanuvchilar ro'yxatini ko'rish huquqi (Telegram id, vergul bilan)
# O'z id ingizni bilish uchun botga /whoami yozing
ADMIN_ID=
